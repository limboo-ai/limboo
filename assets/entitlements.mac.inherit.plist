<?xml version="1.0" encoding="UTF-8"?>
<!--
  Child entitlements — applied to the Electron helper apps and frameworks inside
  Limboo.app.

  `com.apple.security.inherit` makes each child adopt the parent's sandbox and
  entitlements instead of declaring its own. This matters here because Limboo's
  whole purpose is spawning children: cursor-agent, git, and node-pty terminals
  all run under the app and must keep the parent's capabilities.

  The JIT / unsigned-memory / library-validation keys are repeated because the
  renderer and GPU helpers each run their own V8 instance and load the same
  unpacked native addons.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.inherit</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
