<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for the signed + notarized macOS build.

  Notarization requires the hardened runtime, which revokes capabilities unless
  they are declared here. Every key below is load-bearing for Limboo — none is
  copied in "just in case":

  - allow-jit / allow-unsigned-executable-memory: V8 compiles JavaScript at
    runtime. Electron does not launch without these under hardened runtime.
  - disable-library-validation: better-sqlite3, node-pty and sherpa-onnx-node
    load as .node addons out of app.asar.unpacked. Library validation refuses
    any library not signed by the same Team ID, which those are not.
  - allow-dyld-environment-variables: the voice utilityProcess sets
    DYLD_LIBRARY_PATH so the onnxruntime dylibs beside the sherpa-onnx addon
    resolve before it forks.
  - files.user-selected.read-write: the user picks repositories and composer
    attachments through native dialogs.
  - inherit is NOT set here — it belongs to the child entitlements only.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
